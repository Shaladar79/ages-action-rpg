[node name="EchoRangedLesson1" parent="." unique_id=280110426 instance=ExtResource("7_5obdd")]
visible = false
position = Vector2(312, 228)
trigger_id = "echo_slopes_ranged_lesson"
story_flag = "slopes_ranged_lesson_seen"
dialogue_text = "The creatures ahead are different.
Some will not wait for you to come close.
They strike from a distance and force you to move.
Watch the space between you and your enemy.
A ranged attacker is most dangerous when you stand still.
Close the gap, dodge the shot, then strike when you can.
You do not yet have a weapon to answer them from afar.
For now, your feet are your shield."

