[sub_resource type="Resource" id="Resource_3djgd"]
script = ExtResource("5_ub0y7")
quest_id = "village_rockspitter_clear"
quest_title = "The Angry Mountain"
started_flag = "KillRockSpitterStart"
ready_to_turn_in_flag = "KillRockSpitterDone"
completed_flag = "KillRockSpitterComp"
required_flag = "beatle_1_comp"
first_time_dialogue = "Hey Man you look tough. You see the montain is getting angry. So you see the Rock  Spitters look like they are going to move this way, can you go Kill the Rock Spitters on the Slopes."
active_dialogue = "Did you kill the yet?"
ready_to_turn_in_dialogue = "Oh, Good we are safer now that you cleared them out."
completed_dialogue = "Oh I think I know why the Rock Spitters were moving this way. Speak to me again I'll tell you more."
objectives = Array[ExtResource("6_7sfwb")]([SubResource("Resource_7sfwb")])
reward_xp = 10
