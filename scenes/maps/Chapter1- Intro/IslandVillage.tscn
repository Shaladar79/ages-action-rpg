first_time_dialogue = "Welcome to our village, Id like to talk more but we have had a Forrest Beatle make its way into the village, and its didrupting our shop. If you could kill it. The shop will start selling Healing Tonics again."
active_dialogue = "Go kill that Forrest Beatle, its on the west end of town."
ready_to_turn_in_dialogue = "It's dead, good."
completed_dialogue = "The shop is open now, but the villager in the west of town has some work for you, He will teach you about bounty quests and factions."
