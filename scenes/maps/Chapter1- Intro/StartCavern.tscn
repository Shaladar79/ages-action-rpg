[node name="EchoIntroTrigger" parent="." unique_id=280110426 instance=ExtResource("17_7g80t")]
visible = false
position = Vector2(213, 477.00003)
scale = Vector2(0.7, 0.7)
trigger_id = "echo_intro_awakening"
story_flag = "intro_spirit_met"
dialogue_text = "Awaken, Gene Ambrose.
Your second life begins in shadow.
Do not fear the cavern.
Fear only standing still when the world asks you to move.
I am an Echo, a memory given shape.
I was allowed to remain, to guide the one sent by the stars beyond death.
Mezoria is wounded.
The corruption has roots older than kingdoms, older than names.
But survival comes before destiny.
Move, listen, and learn."

[node name="EchoPushRockTrigger" parent="." unique_id=1741898381 instance=ExtResource("17_7g80t")]
visible = false
position = Vector2(390, 536.00006)
scale = Vector2(0.7, 0.7)
trigger_id = "echo_push_rock_lesson"
story_flag = "push_rock_lesson_seen"
dialogue_text = "Some stones in this cavern are loose enough to move.
Push against them, and they may yield.
But take care.
A stone moved without thought may block the path ahead.
The old builders knew this.
When a puzzle may trap itself, they often placed a reset stone nearby.
If the way becomes sealed, seek the reset."
required_flag = "intro_spirit_met"

[node name="EchoBreakableRockTrigger" parent="." unique_id=20013153 instance=ExtResource("17_7g80t")]
visible = false
position = Vector2(451, 465)
scale = Vector2(0.6, 0.6)
trigger_id = "echo_breakable_rock_lesson"
story_flag = "breakable_lesson_seen"
dialogue_text = "Look closely at that stone, Gene.
The cracks are not decoration.
They are weakness.
Not every obstacle falls to every strike.
Some barriers demand the right kind of force.
Your Stone Club carries Bashing force.
Use it against the cracked rock and open the way."
required_flag = "equipment_lesson_seen"

[node name="EchoSaveTotemTrigger" parent="." unique_id=846468557 instance=ExtResource("17_7g80t")]
visible = false
position = Vector2(867, 117)
scale = Vector2(0.8, 0.8)
trigger_id = "echo_save_totem"
story_flag = "save_totem_lesson_seen"
dialogue_text = "Look there, Gene.
That stone bears a different mark from the others.
It is not a path forward, but a way to begin again.
If a moved stone traps the puzzle, touch the reset stone.
The loose stones nearby will return to where they first rested.
Use it when the path is sealed, but do not grow careless.
Some places in Mezoria will not be so forgiving."
required_flag = "breakable_lesson_seen"

[node name="EchoHealingTonicTrigger" parent="." unique_id=1199151662 instance=ExtResource("17_7g80t")]
visible = false
position = Vector2(132, 815.99994)
scale = Vector2(0.7, 0.7)
trigger_id = "echo_healing_tonic_lesson"
story_flag = "hotbar_lesson_seen"
dialogue_text = "That vial is a Healing Tonic.
Crude medicine, but useful when pain comes quickly.
Carrying it is not enough.
Prepare it before you need it.
Open your character screen and place the tonic on one of your hotkeys.
Then you may call on it with keys one through five.
A prepared hand survives what a desperate hand cannot."

[node name="EchoStoneClubTrigger" parent="." unique_id=1471645559 instance=ExtResource("17_7g80t")]
visible = false
position = Vector2(410, 968)
scale = Vector2(0.7, 0.7)
trigger_id = "echo_stone_club_lesson"
story_flag = "equipment_lesson_seen"
dialogue_text = "A Stone Club.
Primitive, heavy, and honest.
It will not help you from inside your pack.
Open your character screen and equip it in your Melee Weapon slot.
This weapon strikes with Bashing force.
Remember that.
Some things break only when struck the right way."
required_flag = "push_rock_lesson_seen"

[node name="EchoCombatLessonTrigger" parent="." unique_id=253619871 instance=ExtResource("17_7g80t")]
visible = false
position = Vector2(859, 284)
trigger_id = "echo_first_combat_lesson"
story_flag = "combat_lesson_seen"
dialogue_text = "The corruption twists even small things.
These creatures are not great threats, but they are not harmless.
Keep your weapon ready.
Strike when there is an opening.
Move when danger closes.
Each enemy has its own habits.
Learn them, and you will live longer.
Do not let fear root you in place."
required_flag = "save_totem_lesson_seen"

