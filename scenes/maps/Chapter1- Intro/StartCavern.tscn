required_defeated_monster_ids = Array[String](["SCEarth1", "SCEarth2", "SCEarth3", "SCEarth4", "SCEarth5", "SCEarth6", "SCEarth7", "SCEarth8", "SCEarth9", "SCEarth10"])
dialogue_text = "The path grows still.
The lesser creatures behind you have fallen.
Beyond this point waits something stronger.
Boss arenas are bound by old forces and violent will.
Once you enter, the way forward will not open while the guardian still lives.
Watch the ground.
Greater enemies often warn where their strongest attacks will land.
When the arena speaks, move."

