[resource]
script = ExtResource("2_sxgnx")
quest_id = "starter_combat_intro_lesson"
quest_title = "Prepare for Combat"
quest_type = 0
started_flag = "starter_combat_intro_lesson_started"
ready_to_turn_in_flag = "starter_combat_intro_lesson_ready"
completed_flag = "starter_combat_intro_lesson_completed"
required_flag = "starter_save_totem_lesson_completed"
first_time_dialogue = "The path ahead is no longer only stone.

There are creatures in the tunnel, and they will not move aside because you ask them to.

Use your weapon to attack.
Keep moving, watch your health, and use your healing tonic if you are badly hurt.

When creatures fall, you gain experience.
With enough experience, you will gain a level.

Each level grants stat points.
You can spend stat points from your character screen to shape how you fight and survive.

Might improves your physical power.
Agility helps with quickness, ranged attacks, and attack speed.
Toughness helps you endure damage.
Endurance strengthens your body and survival.
Focus strengthens magical potential and increases Mana once Mana is unlocked.
Speed improves how quickly you move.

Learn these things now.
The next lesson will not be gentle."
active_dialogue = "Remember what I told you. Your weapon, your tonic, and your stats all matter."
ready_to_turn_in_dialogue = "Good.

You understand enough to begin.
Now you must prove it against living threats."
completed_dialogue = "You have already learned the basics of combat and growth."
summary = "The Echo Spirit explains combat, leveling, and stat points."
objective_text = "Listen to the Echo Spirit's explanation."
objectives = Array[ExtResource("1_7cqce")]([SubResource("Resource_7cqce")])
metadata/_custom_type_script = "uid://dt5yvut01s10s"
