[resource]
script = ExtResource("2_dtkjc")
quest_id = "starter_puzzle_reset_lesson"
quest_title = "Reset the Stones"
quest_type = 0
started_flag = "starter_puzzle_reset_lesson_started"
ready_to_turn_in_flag = "starter_puzzle_reset_lesson_ready"
completed_flag = "starter_puzzle_reset_lesson_completed"
required_flag = "starter_push_rock_lesson_completed"
first_time_dialogue = "Some places in this cavern are not meant to be crossed by strength alone.

Loose stones can block a path, open a path, or trap what lies beyond them.
If you move them poorly, look for a reset stone.

A reset stone returns nearby puzzle stones to where they began.
Move one of the loose stones, use the reset stone, then solve the path and claim what waits behind them.

When you have the pouch, come to me.
"
active_dialogue = "Move one of the loose stones, use the reset stone, then reach the pouch hidden behind the puzzle."
ready_to_turn_in_dialogue = "Good. You have learned something important.

A puzzle is not failure because you moved wrongly.
It is only failure if you stop thinking."
completed_dialogue = "You have already learned how puzzle stones and reset stones work."
summary = "The Echo Spirit wants me to learn how puzzle stones and reset stones work."
objective_text = "Move a stone, use the reset stone, then collect the pouch behind the puzzle."
objectives = Array[ExtResource("1_8h41n")]([SubResource("Resource_8h41n"), SubResource("Resource_dtkjc"), SubResource("Resource_vbkjg")])
metadata/_custom_type_script = "uid://dt5yvut01s10s"
