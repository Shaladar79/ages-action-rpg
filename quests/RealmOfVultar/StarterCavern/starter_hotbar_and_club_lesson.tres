quest_id = "starter_hotbar_and_club_lesson"
quest_title = "Prepare Yourself"
quest_type = 0
started_flag = "starter_hotbar_and_club_lesson_started"
ready_to_turn_in_flag = "starter_hotbar_and_club_lesson_ready"
completed_flag = "starter_hotbar_and_club_lesson_completed"
required_flag = "starter_push_and_reset_lesson_completed"
first_time_dialogue = "You found a healing tonic.

Do not wait until pain teaches you its value.
Open your inventory and place the healing tonic on your hotbar.

A prepared hand survives longer than a strong one.

Once it is ready, take the stone club from the ground.
Then meet me back up the tunnel"
active_dialogue = "Place the healing tonic on your hotbar, then pick up the stone club.
"
ready_to_turn_in_dialogue = "Good.

A tonic can keep you standing.
A weapon can keep danger away.

You are not safe, Gene Ambrose, but you are less helpless than before."
completed_dialogue = "You have already prepared your tonic and weapon."
summary = "The Echo Spirit wants me to prepare a healing tonic and collect a stone club."
objective_text = "Equip a Healing Tonic to the hotbar, pick up the Stone Club, then return to the Echo Spirit."
objectives = Array[ExtResource("1_x2prs")]([SubResource("Resource_x2prs"), SubResource("Resource_p1bia")])
