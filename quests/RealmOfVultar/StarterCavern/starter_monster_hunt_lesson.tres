ready_to_turn_in_flag = "starter_monster_hunt_lesson_ready"
completed_flag = "starter_monster_hunt_lesson_completed"
required_flag = "starter_combat_intro_lesson_completed"
first_time_dialogue = "Now the lesson becomes real.

There are creatures ahead.
Defeat them, but do not rush blindly.

Watch your health.
Use your tonic if you must.
If you gain a level, open your character screen and spend your stat points.

I will move forward as the path becomes safer.
When enough of the creatures are gone, follow me deeper into the tunnel.

Clear the creatures ahead, then return to me.
"
active_dialogue = "Defeat the creatures in the tunnel.
I will move forward as the path becomes safer."
ready_to_turn_in_dialogue = "Good.

You survived the first true danger.
You have learned that growth comes from action, not safety."
completed_dialogue = "You have already cleared this part of the tunnel.
"
summary = "The Echo Spirit wants me to clear the creatures from the tunnel.
"
objective_text = "Defeat 10 creatures in the tunnel."
