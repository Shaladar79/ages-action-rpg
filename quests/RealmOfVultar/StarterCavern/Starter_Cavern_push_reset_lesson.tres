[resource]
script = ExtResource("2_4gjmj")
quest_id = "starter_push_and_reset_lesson"
quest_title = "Move and Reset the Stones"
quest_type = 0
started_flag = "starter_push_and_reset_lesson_started"
ready_to_turn_in_flag = "starter_push_and_reset_lesson_ready"
completed_flag = "starter_push_and_reset_lesson_completed"
required_flag = "starter_movement_lesson_completed"
first_time_dialogue = "Some stones are part of the cavern.
Others are only waiting for a strong enough hand.

Loose rocks can be pushed aside.
Stand near this one and press E to move it.

But not every stone is only an obstacle.
Some can block a path, open a path, or trap what lies beyond them.

If you move them poorly, look for a reset stone.
A reset stone returns nearby puzzle stones to where they began.

Push the loose rock, move one of the puzzle stones, use the reset stone, then solve the path and claim what waits behind it.

When you have the pouch, come back to me."
active_dialogue = "Push the loose rock, move one of the puzzle stones, use the reset stone, then collect the pouch behind the puzzle."
ready_to_turn_in_dialogue = "Good. You noticed the difference.

Not every obstacle must be broken.
Some only need to be moved.

And a puzzle is not failure because you moved wrongly.
It is only failure if you stop thinking."
completed_dialogue = "You have already learned how loose stones and reset stones work."
summary = "The Echo Spirit wants me to learn how loose stones and reset stones work."
objective_text = "Push the loose rock, use the reset stone, and collect the pouch behind the puzzle."
objectives = Array[ExtResource("1_bv6mp")]([SubResource("Resource_4gjmj"), SubResource("Resource_0xsmr")])
metadata/_custom_type_script = "uid://dt5yvut01s10s"
