quest_id = "starter_cavern_boss_lesson"
quest_title = "Quest Title:Face the Cavern Boss"
quest_type = 0
started_flag = "starter_cavern_boss_lesson_started"
ready_to_turn_in_flag = "starter_cavern_boss_lesson_ready"
completed_flag = "starter_cavern_boss_lesson_completed"
required_flag = "starter_monster_hunt_lesson_completed"
first_time_dialogue = "You have cleared the lesser creatures, but this cavern is not finished with you.

Ahead waits the boss of this place.

A mini-boss is usually drawn out by a quest, a challenge, or something you do in an area.
A boss is different.

A boss claims its arena.
Once you step into its domain, the way out will close until it is defeated.

The creature ahead must fall before you can leave this cavern.

Defeat the cavern boss, then follow the path outside.
I will meet you beyond the tunnel."
active_dialogue = "Defeat the cavern boss. Once you enter its arena, you must win before you can leave."
ready_to_turn_in_dialogue = "You did it.

The cavern no longer holds you.
This was your first true trial, Gene Ambrose, but it will not be your last."
completed_dialogue = "You have already defeated the cavern boss."
summary = "The Echo Spirit warns me about bosses and tells me to defeat the cavern boss."
objective_text = "Defeat the cavern boss and leave the cavern."
objectives = Array[ExtResource("1_whh27")]([SubResource("Resource_whh27")])
